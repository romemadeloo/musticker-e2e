# Copy to .env and fill in real values. .env is gitignored — never commit real credentials.
#
# Environment selection: set E2E_ENVIRONMENT to one of the keys below instead of BASE_URL/
# API_BASE_URL to target a named server. Explicit BASE_URL/API_BASE_URL always win if both are
# set. See tests/fixtures/environments.ts for the source of truth.
#
#   production           -> https://www.musticker.com/kr            | https://api.musticker.com/index.php
#   development-static    -> https://dev-static-1.musticker.com/kr   | https://dev-static-1-api.musticker.com/index.php
#   development-1          -> https://dev.musticker.com/kr            | https://dev-api.musticker.com/index.php
#   development-2          -> https://dev-2.musticker.com/kr          | https://dev-2-api.musticker.com/index.php
#   development-3          -> https://dev-3.musticker.com/kr          | https://dev-3-api.musticker.com/index.php
#   development-4          -> https://dev-4.musticker.com/kr          | https://dev-4-api.musticker.com/index.php
#
# Example: E2E_ENVIRONMENT=development-2

E2E_ENVIRONMENT=production
# BASE_URL=
# API_BASE_URL=
HEADED=false
RUN_VISUAL_E2E=false
# off = strict copy matching: a renamed product fails instead of self-healing (see README).
# SELF_HEAL=off

# Test-data cleanup. TEST_DATA_USER_DELETE_ENDPOINT is used by the global teardown
# (tests/setup/global-teardown.ts) to delete the throwaway members the destructive auth tests
# register -- MS-V2-088 and MS-V2-094 each create a real account on the target dev server. The
# teardown issues `DELETE <endpoint>/<url-encoded email>` for every account recorded during the run,
# sending API_TOKEN as a bearer token when it is set.
#
# Leave it blank and nothing breaks: the teardown prints the accounts it could not delete and keeps
# them on the books in .auth/created-accounts.jsonl, so a later configured run still clears them.
API_TOKEN=
TEST_DATA_USER_ENDPOINT=
TEST_DATA_USER_DELETE_ENDPOINT=

# WAF exemption keys for the storefront, issued by the site owner. Sent as the x-internal-origin
# header on musticker.com requests only -- never to the third-party analytics hosts the storefront
# also loads (Google, DoubleClick, Naver). Leave both blank and nothing breaks: the header is simply
# not sent and the 403 retry ladder in tests/fixtures/navigation.ts carries the run instead.
#
# Production and the development-* servers have separate WAFs and separate keys. You can keep both
# filled in at once: env.ts picks by the environment the run is pointed at, so switching
# E2E_ENVIRONMENT is enough and the production key is never sent to a dev host. A BASE_URL that
# matches no known environment sends neither key rather than guessing.
#
# Note that setting whichever key applies turns Playwright tracing OFF (see playwright.config.ts):
# traces record request headers, and this repository's CI artifacts are public.
INTERNAL_ORIGIN_KEY=
DEV_INTERNAL_ORIGIN_KEY=

# Seeded member used by @auth @credentialed tests. Leave blank to skip those tests.
#
# Tests that only need to *be* signed in seed the session from the API instead of driving the login
# form (`test.use({ asMember: true })`, see tests/fixtures/member-auth.ts) -- roughly 10s faster per
# test and immune to the login form's hydration race. The account must exist on the environment under
# test: each development-* server has its own user database, so a production account will not log in
# on a dev host. In CI, production reads AUTH_TEST_* and the dev servers read DEV_AUTH_TEST_*.
AUTH_TEST_EMAIL=
AUTH_TEST_PASSWORD=

# Full-payment tests (checkout-destructive.spec.ts) generate their own disposable guest-checkout
# email via mail.tm (https://docs.mail.tm/, free, no API key/signup needed) and use a hardcoded
# verified shipping profile (tests/fixtures/storefront-data.ts guestCheckoutProfile) -- nothing to
# configure here. The dev-environment KakaoPay tile opens a real "PayApp — Local Mock" sandbox
# popup with a single "Complete card payment" button, not a real card-detail form, so there are no
# card-number/gateway-selector settings either.

# Full payment tests are skipped unless this is true. Only run against a dev sandbox environment
# (RUN_PAYMENT_E2E=true creates a real order there) -- production has no sandbox payment yet.
RUN_PAYMENT_E2E=false

# Account-creating and member-state-mutating tests are skipped unless this is true:
# registration OTP completion (MS-V2-087/088), the password rotation in change-password.spec.ts
# (MS-V2-094), and the guest-to-member cart merge (MS-V2-104, which adds a line to the seeded
# member's real cart and removes it again). Like the payment gate, only turn it on
# against a dev environment: each run registers a real member, and the rotation test changes that
# member's password. Those tests mint their own disposable inbox via mail.tm, so the address is
# never a real one and AUTH_TEST_EMAIL is left untouched -- nothing extra to configure here.
RUN_AUTH_DESTRUCTIVE_E2E=false

# --- Admin panel (tests/e2e/admin) ---
# Admin specs reuse a session captured once by a person, because admin login needs a verification
# code emailed to sales@musticker.com. Capture it with:
#   E2E_ENVIRONMENT=development-static npm run admin:login
# which saves .auth/admin-<environment>.json (gitignored, ~1 week with "Keep me signed in").
# One session per account: signing in to the same panel elsewhere ends the saved one.
#
# Optional: prefill the login form in admin:login. Leave unset to type them in the window yourself.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional override of the panel origin from tests/fixtures/environments.ts (adminPanelUrls).
ADMIN_BASE_URL=

# MS-ADM-001 (order-processing.spec.ts) is skipped unless this is true. It takes a real dev order all
# the way to 주문 완료 and emails the seeded member at each step; it refuses every environment but
# development-static.
RUN_ADMIN_DESTRUCTIVE_E2E=false
# Until dev-static-1's checkout Cloudflare check exempts test traffic, MS-ADM-001 starts from an order
# the seeded member (AUTH_TEST_EMAIL) already placed: paid, one item, still at 디자인 파일 미제출.
# Each run consumes it. Unset means the test skips.
ADMIN_E2E_ORDER_NO=
