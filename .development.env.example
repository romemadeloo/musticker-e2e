# Secrets for the qa and dev-* servers. Copy to .development.env (gitignored) and fill in.
# Loaded automatically unless E2E_ENVIRONMENT=production (tests/setup/load-env.ts); anything also
# set in .env or the real environment wins. See .env.example for what each variable does.
# The GitHub Actions secret each one mirrors is noted in brackets.

# Seeded dev member for @auth @credentialed tests. Each dev-* server has its own user database.
# [DEV_AUTH_TEST_EMAIL / DEV_AUTH_TEST_PASSWORD]
AUTH_TEST_EMAIL=
AUTH_TEST_PASSWORD=

# WAF exemption key for the dev servers. [DEV_INTERNAL_ORIGIN_KEY]
DEV_INTERNAL_ORIGIN_KEY=

# Test-data cleanup of throwaway members. [TEST_DATA_API_TOKEN, variable PROMOTION_USER_DELETE_ENDPOINT]
API_TOKEN=
TEST_DATA_USER_ENDPOINT=
TEST_DATA_USER_DELETE_ENDPOINT=

# Admin panel automation account, used by npm run admin:login. [ADMIN_EMAIL / ADMIN_PASSWORD]
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Saved dev-1 admin session for CI (scripts/ci/admin-session.mjs restore dev-1). Not needed
# locally, where npm run admin:login saves it to .auth/. [ADMIN_SESSION_DEV1]
ADMIN_SESSION_DEV1=

# Dev E2E preflight: true only after confirming sandbox payments. [variable DEV_PAYMENT_SANDBOX_ENABLED]
DEV_PAYMENT_SANDBOX_ENABLED=false
