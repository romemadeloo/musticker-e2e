# Supabase project (Project Settings → API). The anon key is public; the service role key is not.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the Playwright reporter sends as a bearer token to /api/ingest/runs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_INGEST_TOKEN=

# Vercel sends this as a bearer token to /api/cron/scheduler. Set it in Vercel project env vars.
CRON_SECRET=

# Fine-grained GitHub token with Actions: read & write on the suite repository, used to dispatch
# the workflow named in Settings (default manual-playwright.yml).
GITHUB_TOKEN=

# Optional: Slack incoming webhook posted to when a run fails and "Notify on failure" is on.
SLACK_WEBHOOK_URL=

# Public URL of this dashboard, used in notification links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
