# Secrets for production. Copy to .production.env (gitignored) and fill in.
# Loaded automatically when E2E_ENVIRONMENT=production (tests/setup/load-env.ts); anything also set
# in .env or the real environment wins. See .env.example for what each variable does.
# The GitHub Actions secret each one mirrors is noted in brackets.

# Seeded production member for @auth @credentialed tests. A dev account will not log in here.
# [AUTH_TEST_EMAIL / AUTH_TEST_PASSWORD]
AUTH_TEST_EMAIL=
AUTH_TEST_PASSWORD=

# WAF exemption key for production. [INTERNAL_ORIGIN_KEY]
INTERNAL_ORIGIN_KEY=
