{
  "name": "musticker-storefront-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:framework": "node --test scripts/tests/*.test.mjs && playwright test --config playwright.unit.config.ts",
    "promotion:validate": "node scripts/promotion.mjs validate",
    "promotion:apply": "node scripts/promotion.mjs apply",
    "promotion:ci": "node scripts/promotion.mjs ci",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed:ui": "playwright test --headed --ui",
    "test:e2e:list": "playwright test --list",
    "test:prod:smoke": "cross-env E2E_ENVIRONMENT=production BASE_URL=https://www.musticker.com/kr RUN_PAYMENT_E2E=false playwright test --grep @smoke --grep-invert \"@payment|@slow|@destructive\"",
    "test:prod:full": "cross-env E2E_ENVIRONMENT=production BASE_URL=https://www.musticker.com/kr RUN_PAYMENT_E2E=false playwright test --grep-invert \"@payment|@slow|@destructive\"",
    "test:prod:mobile": "cross-env E2E_ENVIRONMENT=production BASE_URL=https://www.musticker.com/kr E2E_BROWSER_PROJECT=chromium-mobile RUN_PAYMENT_E2E=false playwright test --grep @mobile",
    "test:prod:auth": "cross-env E2E_ENVIRONMENT=production BASE_URL=https://www.musticker.com/kr RUN_PAYMENT_E2E=false playwright test --grep @auth --grep-invert \"@payment|@slow|@destructive\"",
    "test:env:smoke": "cross-env RUN_PAYMENT_E2E=false playwright test --grep @smoke --grep-invert \"@payment|@slow|@destructive\"",
    "test:env:full": "cross-env RUN_PAYMENT_E2E=false playwright test --grep-invert \"@payment|@slow|@destructive\"",
    "test:env:mobile": "cross-env E2E_BROWSER_PROJECT=chromium-mobile RUN_PAYMENT_E2E=false playwright test --grep @mobile",
    "test:env:auth": "cross-env RUN_PAYMENT_E2E=false playwright test --grep @auth --grep-invert \"@payment|@slow|@destructive\"",
    "test:smoke": "playwright test --grep @smoke",
    "test:purchasing": "playwright test --grep @purchasing --grep-invert \"@payment|@slow|@destructive\"",
    "test:validation": "playwright test --grep @validation",
    "test:auth": "playwright test --grep @auth",
    "test:api": "playwright test --config playwright.api.config.ts",
    "test:regression": "playwright test --grep @regression",
    "test:a11y": "playwright test --grep @a11y",
    "test:flake": "playwright test --grep @smoke --grep-invert \"@destructive\" --repeat-each=3 --retries=0",
    "test:destructive": "cross-env RUN_PAYMENT_E2E=true RUN_AUTH_DESTRUCTIVE_E2E=true playwright test --grep @destructive",
    "test:destructive:auth": "cross-env RUN_AUTH_DESTRUCTIVE_E2E=true playwright test tests/e2e/storefront/auth --grep @destructive",
    "admin:login": "playwright test --config tests/setup/admin-login.config.ts",
    "test:admin:destructive": "cross-env E2E_ENVIRONMENT=dev-1 RUN_ADMIN_DESTRUCTIVE_E2E=true playwright test tests/e2e/admin --grep @destructive --retries=0",
    "test:ci": "playwright test --grep-invert \"@slow|@destructive|@payment\"",
    "allure:storage:up": "docker compose --env-file ops/allure-report-storage/.env -f ops/allure-report-storage/compose.yaml up --build -d",
    "allure:storage:logs": "docker compose --env-file ops/allure-report-storage/.env -f ops/allure-report-storage/compose.yaml logs -f",
    "allure:storage:down": "docker compose --env-file ops/allure-report-storage/.env -f ops/allure-report-storage/compose.yaml down",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:ui:smoke": "playwright test --grep @critical --grep-invert \"@api|@slow|@destructive|@payment\"",
    "test:ui:full": "playwright test --grep-invert \"@api|@slow|@destructive|@payment\"",
    "test:ui:regression": "playwright test --grep @regression --grep-invert \"@api|@slow|@destructive|@payment\"",
    "test:e2e:dev": "cross-env E2E_BROWSER_PROJECT=chromium-desktop playwright test --config playwright.dev-e2e.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "allure": "^3.14.3",
    "allure-playwright": "^3.9.0",
    "axe-core": "^4.13.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-playwright": "^2.10.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  }
}
